{
  "name": "phenom-backend",
  "version": "1.0.0",
  "description": "Backend API pour l'application Phenom - Observations OVNI",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon --watch src --watch scripts --ext js,json src/app.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage --watchAll=false",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "seed": "node scripts/seed.js",
    "seed:images": "node scripts/seed/download-placeholder-images.js",
    "export:swagger": "node scripts/export-swagger.js",
    "create-admin": "node scripts/create-admin.js",
    "check-db": "node scripts/check-db-connection.js",
    "migrate-to-atlas": "node scripts/migrate-to-atlas.js",
    "generate-ai-images": "node scripts/generate-ai-images.js",
    "generate-ai-images:dry": "node scripts/generate-ai-images.js --dry-run"
  },
  "keywords": [
    "ufo",
    "observation",
    "api",
    "node",
    "express"
  ],
  "author": "Équipe Phenom",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.8.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.34.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "wsmini": "^1.2.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
