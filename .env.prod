# Production Environment Variables
NODE_ENV=production
PORT=3000

# MongoDB Configuration
MONGODB_URI=mongodb://admin:changeme-in-production-secure-password-2025@mongodb:27017/phenom?authSource=admin
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=changeme-in-production-secure-password-2025

# JWT Configuration (CHANGEZ CES SECRETS EN PRODUCTION!)
JWT_SECRET=phenom-production-secret-change-this-to-random-string-2025
JWT_EXPIRE=1h
JWT_REFRESH_SECRET=phenom-production-refresh-secret-change-this-2025
JWT_REFRESH_EXPIRE=7d

# CORS Configuration
CORS_ORIGIN=http://localhost,http://localhost:80

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
UPLOAD_DIR=uploads

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# API Configuration
API_PREFIX=/api/v1

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_NAME=Phenom
