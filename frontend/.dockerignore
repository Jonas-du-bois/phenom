# ============================================================================
# .dockerignore - Frontend
# Exclure les fichiers inutiles du contexte Docker
# ============================================================================

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# package-lock.json (NÉCESSAIRE pour npm ci dans Docker!)
pnpm-lock.yaml

# Environment
.env
.env.*
!.env.example

# Build
dist/
.cache/

# Tests
tests/
coverage/
*.test.js
*.spec.js
e2e/
cypress/

# Documentation
*.md
!README.md
docs/

# Git
.git/
.gitignore
.gitattributes

# IDE
.vscode/
.idea/
*.swp
*.swo
*.swn
.DS_Store

# Logs
logs/
*.log

# CI/CD
.github/
.gitlab-ci.yml
.circleci/

# Docker
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore

# Assets bruts (si applicable)
src/assets/raw/
public/raw/
