# Configuration Frontend Phenom
# Variables d'environnement pour Vite
# Copiez ce fichier en .env et ajustez les valeurs selon votre environnement

# ===================================================================
# API Backend
# ===================================================================

# URL de base du backend (sans le préfixe /api/v1)
# Production: https://phenom-backend.onrender.com
# Local: http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Préfixe de l'API (utilisé pour construire l'URL complète)
# La plupart des endpoints sont sous /api/v1
# Exceptions: /health, /api-docs
VITE_API_PREFIX=/api/v1

# ===================================================================
# WebSocket
# ===================================================================

# URL du WebSocket
# Production: wss://phenom-backend.onrender.com
# Local: ws://localhost:3000
VITE_WS_URL=ws://localhost:3000

# ===================================================================
# Application
# ===================================================================

# Nom de l'application
VITE_APP_NAME=Phenom

# ===================================================================
# Carte
# ===================================================================

# URL des tuiles de carte OpenStreetMap
VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ===================================================================
# Notes importantes
# ===================================================================
# - Toutes les variables doivent commencer par VITE_ pour être accessibles côté client
# - L'URL complète de l'API sera: VITE_API_BASE_URL + VITE_API_PREFIX
#   Exemple: http://localhost:3000 + /api/v1 = http://localhost:3000/api/v1
# - Le health check est accessible à: VITE_API_BASE_URL/health (sans le préfixe)
