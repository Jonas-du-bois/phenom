.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log

# Docker
.docker/

# Testing
coverage/
.nyc_output/

# Uploads
uploads/
backend/uploads/

# Backups
backups/

# OS
Thumbs.db

# docs (ignore documentation folder, except API docs)
docs/
!backend/src/public/docs/

